{
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "fmp": {
      "command": "npx",
      "args": ["-y", "aigroup-fmp-mcp"],
      "env": {
        "FMP_API_KEY": "${FMP_API_KEY}"
      }
    }
  }
}
